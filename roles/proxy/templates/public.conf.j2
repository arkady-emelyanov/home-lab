# {{ ansible_managed }}
#
# The only server blocks listening on 443, and the only names reachable from
# outside this house.
{#
  What every forwarded location does, whether it is a whole name or one route
  of several.
#}
{% macro proxied(site, upstream, host) %}
        proxy_pass {{ upstream }};

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host {{ host }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering {{ 'on' if site.buffering else 'off' }};
        proxy_read_timeout {{ site.read_timeout }};
        proxy_send_timeout {{ site.read_timeout }};
{%- endmacro %}
{% for site in proxy_public_sites %}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ site.name }};

    ssl_certificate     /etc/letsencrypt/live/{{ site.name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ site.name }}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Tell browsers to come back over TLS without being asked. Port 80 is not
    # forwarded, so there is no redirect to fall back on.
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy no-referrer-when-downgrade always;

    client_max_body_size {{ site.max_body }};

{% if site.routes is defined %}
{% for route in site.routes %}
{% if not loop.first %}

{% endif %}
    location = {{ route.path }} {
{{ proxied(site, route.upstream, route.host | default('$host')) }}
    }
{% endfor %}

    # Every path no route names.
    location / {
        return 404;
    }
{% else %}
    location {{ '^~ ' ~ site.only if site.only is defined else '/' }} {
{{ proxied(site, site.upstream, '$host') }}
    }
{% if site.only is defined %}

    # Everything outside {{ site.only }} stays in the house.
    location / {
        return 404;
    }
{% endif %}
{% endif %}
}
{% endfor %}

# Anything else arriving on 443 -- an address, a scanner guessing names, a
# forged Host -- gets the connection closed rather than served by whichever
# block happens to be first.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate     /etc/letsencrypt/live/{{ proxy_public_sites[0].name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ proxy_public_sites[0].name }}/privkey.pem;
    return 444;
}
