# {{ ansible_managed }}
#
# Type=oneshot with RemainAfterExit, because the thing being run is a compose
# project: the command returns once the container is up, and the unit stands
# for "this project is running" rather than for a process. --wait holds the
# start until the service reports healthy.
#
# No Restart=: systemd refuses it on a oneshot, and it would be the wrong layer
# anyway. A container that dies is restarted by docker, which the compose
# project asks for itself. This unit exists for the other case -- the project
# not being there at all, which is what a `docker compose down` leaves behind.
[Unit]
Description=Gatus
Documentation=https://gatus.io
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ gatus_dir }}
ExecStart=/usr/bin/docker compose up -d --remove-orphans --wait
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
