# {{ ansible_managed }}
[Unit]
Description=Blocky DNS proxy and ad blocker
# Blocky binds its DNS port at startup and fetches blocklists over the network,
# so it must not race the interface coming up. network-online.target alone is
# not enough under ifupdown: nothing waits on it, so it is satisfied instantly.
After=networking.service

[Service]
User={{ blocky_user }}
# Binding port 53 as a non-root user needs exactly this capability, rather than
# running the whole resolver as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart={{ blocky_install_dir }}/blocky --config {{ blocky_config_dir }}/config.yml
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
