#!/usr/bin/env python3
# {{ ansible_managed }}
"""Answer whether this container's traffic is actually leaving through the tunnel.

Checking that wg0 exists is not enough, and neither is checking the handshake:
both can look healthy while traffic takes the default route. The only answer
that means anything is the address the internet sees us as -- so this asks, and
compares it with the address this house has.

They are compared by resolving {{ qbittorrent_health_home_name }}, which
pve_ddns keeps pointed at this site. If the two match, the tunnel is not
carrying our traffic and the kill switch has not caught it, which is precisely
the failure worth waking up for.

Stdlib only, and the result is cached: the dashboard scrapes every minute and
there is no reason to ask a stranger for our address that often.
"""

import json
import socket
import subprocess
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

INTERFACE = "{{ qbittorrent_wg_interface }}"
HOME_NAME = "{{ qbittorrent_health_home_name }}"
STALE_AFTER = {{ qbittorrent_handshake_stale_after }}
CACHE_SECONDS = {{ qbittorrent_health_cache_seconds }}
PORT = {{ qbittorrent_health_port }}
ECHO_URL = "{{ qbittorrent_health_echo_url }}"

_cache = {"at": 0.0, "ok": False, "body": {}}


def handshake_age():
    """Seconds since the most recent handshake, or None if the interface is gone."""
    done = subprocess.run(
        ["wg", "show", INTERFACE, "latest-handshakes"],
        capture_output=True, text=True,
    )
    if done.returncode != 0:
        return None
    ages = [
        time.time() - int(line.split()[1])
        for line in done.stdout.splitlines()
        if len(line.split()) == 2 and int(line.split()[1]) > 0
    ]
    return min(ages) if ages else None


def probe():
    state = {"interface": INTERFACE}

    age = handshake_age()
    if age is None:
        state["status"] = "down"
        state["detail"] = f"{INTERFACE} is not up"
        return False, state
    state["handshake_age"] = round(age)
    if age > STALE_AFTER:
        state["status"] = "stale"
        state["detail"] = f"last handshake {round(age)}s ago"
        return False, state

    try:
        with urllib.request.urlopen(ECHO_URL, timeout=15) as response:
            egress = response.read().decode().strip()
    except Exception as exc:  # noqa: BLE001 -- any failure here is a failure
        state["status"] = "unreachable"
        state["detail"] = f"could not determine our address: {exc}"
        return False, state
    state["egress"] = egress

    try:
        home = socket.gethostbyname(HOME_NAME)
    except OSError as exc:
        state["status"] = "unknown"
        state["detail"] = f"could not resolve {HOME_NAME}: {exc}"
        return False, state
    state["home"] = home

    if egress == home:
        state["status"] = "leaking"
        state["detail"] = "traffic is leaving on this site's own address"
        return False, state

    state["status"] = "ok"
    return True, state


def current():
    if time.time() - _cache["at"] > CACHE_SECONDS:
        ok, body = probe()
        _cache.update(at=time.time(), ok=ok, body=body)
    return _cache["ok"], _cache["body"]


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):  # noqa: N802 -- named by the base class
        ok, body = current()
        payload = json.dumps(body).encode()
        self.send_response(200 if ok else 503)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *_args):
        """Silent: a scrape a minute would otherwise fill the journal."""


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
