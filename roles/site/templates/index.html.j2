<!doctype html>
<!-- {{ ansible_managed }} -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#000000">
<title>{{ site_domain }}</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<style>
  :root { --bg: #000; --fg: rgba(236, 240, 255, 0.86); --name: rgba(236, 240, 255, 0.34);
    --dim: rgba(236, 240, 255, 0.42); --faint: rgba(236, 240, 255, 0.26); }
  html, body { margin: 0; height: 100%; overflow: hidden; background: var(--bg); color: var(--fg);
    font: 300 13px/1.4 -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent;
    user-select: none; -webkit-user-select: none; touch-action: none; }
  canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }
  .title { position: fixed; left: max(20px, env(safe-area-inset-left)); top: max(20px, env(safe-area-inset-top)); pointer-events: none; }
  .title h1 { margin: 0; font-weight: 300; font-size: 15px; letter-spacing: 0.24em; }
  .corner { position: fixed; right: max(20px, env(safe-area-inset-right)); bottom: max(18px, env(safe-area-inset-bottom));
    display: flex; flex-direction: column; align-items: flex-end; gap: 6px; text-align: right; pointer-events: none; }
  .name { color: var(--name); font-size: 12px; letter-spacing: 0.22em; }
  .caption { max-width: min(360px, 72vw); color: rgba(236, 240, 255, 0.42); font-size: 11px; line-height: 1.5; letter-spacing: 0.01em; }
  .caption a { color: rgba(236, 240, 255, 0.62); text-decoration: underline; text-decoration-color: rgba(236, 240, 255, 0.25); text-underline-offset: 2px; pointer-events: auto; }
  .caption a:hover { color: rgba(236, 240, 255, 0.9); }
  .notice { max-width: min(380px, 70vw); color: rgba(236, 240, 255, 0.26); font-size: 10px; line-height: 1.45; letter-spacing: 0.02em; }
  .links { display: flex; gap: 14px; margin-top: 12px; pointer-events: auto; }
  .links a { color: var(--faint); display: block; line-height: 0; transition: color 0.3s ease; }
  .links a:hover, .links a:focus-visible { color: var(--dim); outline: none; }
  .links svg { width: 15px; height: 15px; fill: currentColor; }
  .fade { animation: fade 2.4s ease both; }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div class="title fade">
  <h1>{{ site_domain }}</h1>
  <nav class="links">
    <a href="{{ site_github_url }}" aria-label="GitHub" rel="me noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg></a>
    <a href="{{ site_linkedin_url }}" aria-label="LinkedIn" rel="me noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
  </nav>
</div>
<div class="corner fade" id="corner"><div class="name"></div><div class="caption"></div><div class="notice"></div></div>
<script>
(() => {
  // one scene at random, never the one shown last time -- or the one named in the URL
  const SCENES = ["milky-way", "solar-system", "deep-space-nine", "earth"];
  let last = null;
  try { last = localStorage.getItem("scene"); } catch (e) {}
  const pool = SCENES.length > 1 ? SCENES.filter((s) => s !== last) : SCENES;
  const asked = location.hash.slice(1);                 // #milky-way etc. shows that one
  const pick = SCENES.includes(asked) ? asked : pool[Math.floor(Math.random() * pool.length)];
  try { localStorage.setItem("scene", pick); } catch (e) {}
  const load = (src) => new Promise((ok, fail) => { const s = document.createElement("script"); s.src = src; s.onload = ok; s.onerror = fail; document.body.appendChild(s); });
  const show = (name) => load("scenes/" + name + ".js").then(() => {
    const m = window.META || {};
    // a scene with live data fetches it first; if it cannot, show another scene instead
    return !m.fetch ? m : fetch(m.fetch, { cache: "no-cache" }).then((r) => { if (!r.ok) throw r.status; return r.json(); })
      .then((d) => { Object.assign(window.DATA, d); return m; });
  });
  show(pick).catch(() => show(SCENES.filter((s) => s !== pick && s !== "earth")[0])).then((m) => {
    const corner = document.getElementById("corner"), site = document.querySelector("h1").textContent;
    document.title = m.name ? site + " · " + m.name : site;
    corner.querySelector(".name").textContent = m.name || "";
    corner.querySelector(".caption").innerHTML = m.caption || "";
    corner.querySelector(".notice").textContent = m.notice || "";
    for (const el of corner.querySelectorAll(".caption, .notice")) if (!el.innerHTML) el.remove();
    return load("engine.js");
  });
})();
</script>
</body>
</html>
