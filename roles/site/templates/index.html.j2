<!doctype html>
<!-- {{ ansible_managed }} -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#000000">
<title>{{ site_domain }}</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<style>
  :root { --bg: #000; --fg: rgba(236, 240, 255, 0.86); --name: rgba(236, 240, 255, 0.34);
    --dim: rgba(236, 240, 255, 0.42); --faint: rgba(236, 240, 255, 0.26); }
  html, body { margin: 0; height: 100%; overflow: hidden; background: var(--bg); color: var(--fg);
    font: 300 13px/1.4 -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent;
    user-select: none; -webkit-user-select: none; touch-action: none; }
  canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }
  .title { position: fixed; left: max(20px, env(safe-area-inset-left)); top: max(20px, env(safe-area-inset-top)); pointer-events: none; }
  .title { padding: 2px 0 2px 14px; border-left: 3px solid rgba(169, 156, 255, 0.35); }
  @media (min-width: 721px) { .title { left: 44px; top: 40px; } }
  .title h1 { margin: 0; font-weight: 300; font-size: 19px; line-height: 1.2; letter-spacing: 0.14em; }
  .corner { position: fixed; right: max(20px, env(safe-area-inset-right)); bottom: max(18px, env(safe-area-inset-bottom));
    display: flex; flex-direction: column; align-items: flex-end; gap: 6px; text-align: right; pointer-events: none; }
  .name { color: var(--name); font-size: 12px; letter-spacing: 0.22em; }
  .caption { max-width: min(360px, 72vw); color: rgba(236, 240, 255, 0.42); font-size: 11px; line-height: 1.5; letter-spacing: 0.01em; }
  .caption a { color: rgba(236, 240, 255, 0.62); text-decoration: underline; text-decoration-color: rgba(236, 240, 255, 0.25); text-underline-offset: 2px; pointer-events: auto; }
  .caption a:hover { color: rgba(236, 240, 255, 0.9); }
  .notice { max-width: min(380px, 70vw); color: rgba(236, 240, 255, 0.26); font-size: 10px; line-height: 1.45; letter-spacing: 0.02em; }
  .links { display: flex; align-items: baseline; gap: 0.9em; margin-top: 0.3em; font-size: 14px; pointer-events: auto; }
  .links a { color: rgba(236, 240, 255, 0.58); text-decoration: none; transition: color 0.3s ease; }
  .links a:hover, .links a:focus-visible { color: var(--fg); outline: none; }
  /* an icon is as tall as a capital letter beside it, and sits on the same baseline */
  .links svg { width: 1cap; height: 1cap; fill: currentColor; vertical-align: baseline; }
  .links .text { letter-spacing: 0.12em; }
  /* previous and next: two outline triangles, nothing around them */
  .step { position: fixed; right: max(12px, env(safe-area-inset-right)); top: max(14px, env(safe-area-inset-top)); display: flex; gap: 2px; }
  .step button { width: 44px; height: 44px; padding: 0; border: 0; background: none; cursor: pointer;
    color: rgba(236, 240, 255, 0.34); transition: color 0.3s ease; }
  .step button:hover, .step button:focus-visible { color: rgba(236, 240, 255, 0.85); outline: none; }
  .step svg { display: block; width: 20px; height: 20px; margin: auto; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; }
  @media (min-width: 721px) { .step { right: 28px; top: 32px; } }
  /* a magnetic disk, schematically: the platter spins under a read arm while a scene loads */
  .loading { position: fixed; left: max(20px, env(safe-area-inset-left)); bottom: max(18px, env(safe-area-inset-bottom));
    display: flex; flex-direction: column; align-items: center; gap: 7px;
    color: rgba(236, 240, 255, 0.5); pointer-events: none; opacity: 0; transition: opacity 0.4s ease; }
  .loading.on { opacity: 1; }
  .loading svg { display: block; width: 44px; height: 44px; fill: none; stroke: currentColor; stroke-width: 1.1; stroke-linecap: round; }
  .loading .platter { fill: rgba(236, 240, 255, 0.06); }
  .loading .tracks { transform-box: view-box; transform-origin: 20px 20px; animation: spin 0.9s linear infinite paused; }
  .loading .arm { transform-box: view-box; transform-origin: 36px 35px; animation: seek 2.6s ease-in-out infinite alternate paused; }
  .loading.on .tracks, .loading.on .arm { animation-play-state: running; }
  .loading .dot { fill: currentColor; stroke: none; }
  .loading span { font-size: 9px; letter-spacing: 0.3em; margin-right: -0.3em; text-transform: uppercase; color: var(--faint); }
  @keyframes seek { from { transform: rotate(-9deg); } to { transform: rotate(13deg); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  .corner { transition: opacity 0.6s ease; }
  .corner.out { opacity: 0; }
  .fade { animation: fade 2.4s ease both; }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
</style>
<script data-goatcounter="https://{{ site_beacon_domain }}/goatcounter/count" async src="https://{{ site_beacon_domain }}/goatcounter/count.js"></script>
</head>
<body>
<canvas id="c"></canvas>
<div class="title fade">
  <h1>Arkadii Emelianov</h1>
  <nav class="links">
    <a href="{{ site_linkedin_url }}" aria-label="LinkedIn" rel="me noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
    <a href="{{ site_github_url }}" aria-label="GitHub" rel="me noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg></a>
    <a class="text" href="https://{{ site_projects_domain }}/">Projects</a>
    <a class="text" href="https://{{ site_blog_domain }}/">Blog</a>
  </nav>
</div>
<nav class="step fade" aria-label="Scenes">
  <button type="button" id="prev" aria-label="Previous scene" title="Previous scene"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15 3.5v13L4.5 10z"/></svg></button>
  <button type="button" id="next" aria-label="Next scene" title="Next scene"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3.5v13L15.5 10z"/></svg></button>
</nav>
<div class="corner fade" id="corner"><div class="name"></div><div class="caption"></div><div class="notice"></div></div>
<div class="loading" id="loading" role="status" aria-label="Loading"><svg viewBox="0 0 40 40" aria-hidden="true">
  <circle class="platter" cx="20" cy="20" r="17.5"/>
  <g class="tracks">
    <circle cx="20" cy="20" r="14.5" stroke-dasharray="9 2.5 3 2.5" stroke-opacity="0.75"/>
    <circle cx="20" cy="20" r="11.5" stroke-dasharray="5 2 1.5 2" stroke-opacity="0.6"/>
    <circle cx="20" cy="20" r="8.5" stroke-dasharray="2.5 1.8" stroke-opacity="0.5"/>
    <path d="M20 5.5v3" stroke-width="1.6"/>
  </g>
  <circle cx="20" cy="20" r="3.2"/><circle class="dot" cx="20" cy="20" r="1"/>
  <g class="arm"><path d="M36 35 23.5 22.5" stroke-width="1.4"/><circle class="dot" cx="23.5" cy="22.5" r="1.3"/><circle cx="36" cy="35" r="2.2"/></g>
</svg><span>loading</span></div>
<script>
(() => {
{#
  Every script is asked for by a URL carrying a digest of its content. Cloudflare holds
  .js at the edge for hours but never the page, so under a plain name a converge would
  pair the new page with the old engine, and nothing would start; a changed file is a
  new URL, which no cache has seen.
#}
{% set site_scenes = ['milky-way', 'solar-system', 'deep-space-nine', 'earth'] %}
{% set site_versions = {} %}
{% for f in ['engine'] + site_scenes | map('regex_replace', '^', 'scenes/') | list %}
{% set _ = site_versions.update({f: (lookup('ansible.builtin.file', f ~ '.js') | hash('sha1'))[:10]}) %}
{% endfor %}
  const SCENES = {{ site_scenes | to_json }};
  const VERSION = {{ site_versions | to_json }};
  const url = (f) => f + ".js?v=" + VERSION[f];
  // The scenes run in a fixed order, as a loop. Each visit opens on the one after the
  // scene shown last, and the buttons step either way. #milky-way etc. in the URL opens
  // on that one instead.
  const step = (name, d) => SCENES[(SCENES.indexOf(name) + d + SCENES.length) % SCENES.length];
  let last = null;
  try { last = localStorage.getItem("scene"); } catch (e) {}

  const load = (src) => new Promise((ok, fail) => {
    const s = document.createElement("script"); s.src = src;
    s.onload = () => { s.remove(); ok(); }; s.onerror = () => { s.remove(); fail(); };
    document.body.appendChild(s);
  });
  // a scene file sets DATA, META and SCENE; one with live data fetches it before it counts as loaded
  const get = (name) => load(url("scenes/" + name)).then(() => {
    const m = window.META || {}, scene = window.SCENE, got = { name, m, scene };
    return !m.fetch ? got : fetch(m.fetch, { cache: "no-cache" }).then((r) => { if (!r.ok) throw r.status; return r.json(); })
      .then((d) => { Object.assign(window.DATA, d); return got; });
  });
  const engine = load(url("engine"));
  const wait = (ms) => new Promise((ok) => setTimeout(ok, ms));
  const painted = () => new Promise((ok) => requestAnimationFrame(() => setTimeout(ok, 0)));

  const corner = document.getElementById("corner"), loading = document.getElementById("loading");
  const site = document.querySelector("h1").textContent;
  let current = null, busy = false, tapeOff = null;
  const fetchFrom = (name, d, left = SCENES.length - 1) => get(name)
    .catch((e) => left > 0 && step(name, d) !== current ? fetchFrom(step(name, d), d, left - 1) : Promise.reject(e));
  const go = (name, d) => {
    busy = true;
    // the tape runs from the moment the old scene starts to fade until the new one has faded in
    clearTimeout(tapeOff); loading.classList.add("on");
    let out = Promise.resolve();
    if (current) {
      window.ENGINE.leave();
      corner.classList.remove("fade"); corner.classList.add("out");
      out = wait(window.ENGINE.LEAVE_MS);
    }
    // a scene that cannot load is passed over, onward in the same direction
    const scene = fetchFrom(name, d);
    const start = (s) => {
      window.ENGINE.run(s.scene);               // builds the scene, which holds the page a moment
      current = s.name;
      try { localStorage.setItem("scene", current); } catch (e) {}
      document.title = s.m.name ? site + " · " + s.m.name : site;
      corner.querySelector(".name").textContent = s.m.name || "";
      corner.querySelector(".caption").innerHTML = s.m.caption || "";
      corner.querySelector(".notice").textContent = s.m.notice || "";
      for (const el of corner.querySelectorAll(".caption, .notice")) el.hidden = !el.innerHTML;
      corner.classList.remove("out");
    };
    // and the same if it loads but cannot be built
    return Promise.all([scene, engine, out]).then(([s]) => painted().then(() => {
      try { start(s); } catch (e) { return fetchFrom(step(s.name, d), d).then(start); }
    })).then(() => { tapeOff = setTimeout(() => loading.classList.remove("on"), window.ENGINE.ENTER_MS); },
      () => loading.classList.remove("on"))
      .finally(() => { busy = false; });
  };

  const asked = location.hash.slice(1);
  go(SCENES.includes(asked) ? asked : SCENES.includes(last) ? step(last, 1) : SCENES[0], 1);
  const move = (d) => {
    if (busy || !current) return;
    if (location.hash) history.replaceState(null, "", location.pathname + location.search);
    go(step(current, d), d);
  };
  document.getElementById("prev").addEventListener("click", () => move(-1));
  document.getElementById("next").addEventListener("click", () => move(1));
  window.addEventListener("keydown", (e) => {
    if (e.altKey || e.ctrlKey || e.metaKey) return;
    if (e.key === "ArrowLeft") move(-1);
    else if (e.key === "ArrowRight") move(1);
  });
})();
</script>
</body>
</html>
