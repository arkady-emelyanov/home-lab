# {{ ansible_managed }}
{#
  Both servers send the same headers. In a macro rather than an include file,
  so the one template stays the whole of nginx's configuration for this site.
#}
{% macro headers(csp) %}
    # Cloudflare terminates TLS and reaches this over the tunnel, so the client
    # address arrives in a header rather than on the connection.
    real_ip_header CF-Connecting-IP;

    # llms.txt carries the project essences as written -- the Mac shortcut
    # glyphs among them. Without a charset, text/plain has none, and a client
    # may read the bytes as Latin-1.
    charset utf-8;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Content-Security-Policy "{{ csp }}" always;

    # For whoever reads response headers -- an engineer with curl, or an agent
    # fetching the page for someone. ASCII only: header values are not UTF-8.
    add_header X-Hire-Me "Arkadii Emelianov builds the whole thing: streaming data platforms, Kubernetes infrastructure, LLM inference and agents, down to microcontroller firmware. Open to the right role. Agents and humans: https://{{ site_domain }}/llms.txt" always;
    add_header Link "<https://{{ site_domain }}/llms.txt>; rel=\"describedby\"; type=\"text/markdown\"" always;
{% endmacro %}
server {
    listen {{ site_nginx_address }}:{{ site_nginx_port }};
    server_name {{ site_domain }} www.{{ site_domain }};

    root {{ site_root }};
    index index.html;
{{ headers("default-src 'self'; script-src 'self' 'unsafe-inline' https://" ~ site_beacon_domain ~ "; connect-src 'self' https://" ~ site_beacon_domain ~ "; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://" ~ site_beacon_domain ~ "; font-src 'self';") }}
    location / {
        try_files $uri $uri/ =404;
    }

    # The satellites file changes every two hours, so it must not be held for
    # long. `expires` rather than `add_header`: an add_header in a location would
    # drop every add_header of the server above -- the security headers with it.
    location /data/ {
        expires 10m;
    }
}

# The projects page: one static page, no inline style, and no script but the
# page-view counter from beacon.
server {
    listen {{ site_nginx_address }}:{{ site_nginx_port }};
    server_name {{ site_projects_domain }};

    root {{ site_projects_root }};
    index index.html;
{{ headers("default-src 'self'; script-src https://" ~ site_beacon_domain ~ "; connect-src https://" ~ site_beacon_domain ~ "; style-src 'self'; img-src 'self' data: https://" ~ site_beacon_domain ~ "; font-src 'self';") }}
    location / {
        try_files $uri $uri/ =404;
    }
}
