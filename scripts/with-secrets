#!/bin/sh
# Ask for the database passphrase once, then run the given command with it in
# the environment.
#
# This exists because of where Ansible evaluates a lookup: task arguments are
# templated inside the forked worker, not in the controller. A worker has no
# usable stdin, so the plugin cannot prompt -- and each fork has its own copy of
# the plugin's memory, so a cached passphrase would not be shared even if it
# could. The prompt has to happen before the fork, which means out here.
#
# The trade is that the passphrase sits in this process's environment, readable
# through /proc by this user and by root, for as long as the converge runs. That
# is worse than memory-only and better than the secrets themselves being files
# on disk, which is what this replaces.
set -eu

if [ -n "${NAS_SECRETS_PASSPHRASE:-}" ]; then
    exec "$@"
fi

# Asked for rather than repeated here, so the path lives only in
# inventory/group_vars/all.yml.
DB="$(python3 -c 'import pathlib,sys; sys.path.insert(0, str(pathlib.Path("'"$(dirname "$0")"'").resolve())); import _keepass; print(_keepass.DB)')"
[ -f "$DB" ] || { echo "no database at $DB" >&2; exit 1; }

printf 'Passphrase for %s: ' "$(basename "$DB")" >&2
stty -echo 2>/dev/null || true
IFS= read -r NAS_SECRETS_PASSPHRASE
stty echo 2>/dev/null || true
printf '\n' >&2

export NAS_SECRETS_PASSPHRASE
exec "$@"
