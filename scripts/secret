#!/usr/bin/env python3
"""Put a secret into the automation database, or take one out.

    secret add <entry>              type the value, it is stored
    secret add <entry> --file PATH  store a file as an attachment
    secret list [group]             what exists
    secret rm <entry>               delete an entry

An entry is named by its path below the nas-next group, and that is exactly
what a role looks up:

    secret add jellyfin/api-key     ->  lookup('keepass', 'jellyfin/api-key')

Values are typed, never generated here. A password this script invented is one
nobody chose and nobody can find later. Use --generate only when the value is
genuinely arbitrary and you have decided so yourself.

Custom attributes cannot be set from the command line -- keepassxc-cli's edit
only reaches title, username, url, notes and password -- so an entry that needs
one (qbittorrent's stored hash, say) gets it in the GUI.
"""

import argparse
import getpass
import pathlib
import secrets as _secrets
import string
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import _keepass as kp


def cmd_add(args):
    entry = args.entry.strip("/")

    if args.file:
        source = pathlib.Path(args.file).expanduser()
        if not source.is_file():
            sys.exit(f"no such file: {source}")
        kp.attach(entry, source, notes=args.notes)
        print(f"stored {source.name} as an attachment on {kp.GROUP}/{entry}")
    else:
        if args.generate:
            alphabet = string.ascii_letters + string.digits
            value = "".join(_secrets.choice(alphabet) for _ in range(args.length))
        else:
            value = getpass.getpass(f"Value for {entry}: ")
            if value != getpass.getpass("Repeat: "):
                sys.exit("values do not match")
            if not value:
                sys.exit("nothing typed")
        kp.put(entry, value, notes=args.notes)
        print(f"stored {len(value)} characters in {kp.GROUP}/{entry}")

    print(f"\nread it with:  lookup('keepass', '{entry}')")


def cmd_list(args):
    group = (args.group or "").strip("/")
    found = kp.entries(group)
    if not found:
        print(f"nothing in {kp.GROUP}/{group}" if group else f"nothing in {kp.GROUP}")
        return
    for name in found:
        print(f"{group + '/' if group else ''}{name}")


def cmd_rm(args):
    entry = args.entry.strip("/")
    if not kp.run(["show", f"{kp.GROUP}/{entry}"]).returncode == 0:
        sys.exit(f"no entry {entry}")
    kp.remove(entry)
    print(f"removed {kp.GROUP}/{entry}")


def main():
    parser = argparse.ArgumentParser(
        prog="secret", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", metavar="<command>")

    p = sub.add_parser("add", help="store a value or a file")
    p.add_argument("entry", help="path below the nas-next group, e.g. jellyfin/api-key")
    p.add_argument("--file", help="store this file as an attachment instead of typing a value")
    p.add_argument("--notes", help="what it is for")
    p.add_argument("--generate", action="store_true", help="generate the value instead of typing it")
    p.add_argument("--length", type=int, default=40, help="length when generating (default 40)")
    p.set_defaults(handler=cmd_add)

    p = sub.add_parser("list", help="list entries in a group")
    p.add_argument("group", nargs="?", help="group below nas-next; omit for the top")
    p.set_defaults(handler=cmd_list)

    p = sub.add_parser("rm", help="delete an entry")
    p.add_argument("entry")
    p.set_defaults(handler=cmd_rm)

    args = parser.parse_args()
    if not getattr(args, "handler", None):
        parser.print_help()
        return
    args.handler(args)


if __name__ == "__main__":
    main()
