# Anything that looks like a key, wherever it lands.
*.pem
*.key
*_rsa
*_ed25519
id_*
!*.pub

# Downloaded artifacts, pinned in requirements.yml.
collections/

# Ansible run state.
.ansible
*.retry
.facts_cache/

# Python.
.venv/
__pycache__/

# Local tooling scratch state.
.omc/

# Anything kept beside the repository but never in it. The identity seeding
# script lands here: it holds the values this repository deliberately does not.
/.local/
